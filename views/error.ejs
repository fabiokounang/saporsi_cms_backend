<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Gagal • Samakan CMS</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: Montserrat, system-ui, Segoe UI, Roboto, Arial, sans-serif;
      background: #f6f4f1;
      color: #111827;
    }
    .card {
      width: min(520px, calc(100% - 32px));
      background: #fff;
      border: 1px solid #ece7e1;
      border-radius: 18px;
      padding: 28px 24px;
      box-shadow: 0 18px 50px rgba(16, 24, 40, 0.08);
    }
    .code { font-size: 12px; font-weight: 700; color: #b45309; margin: 0 0 8px; }
    h1 { margin: 0 0 10px; font-size: 20px; }
    p { margin: 0 0 18px; color: #6b7280; line-height: 1.6; font-size: 14px; }
    a {
      display: inline-block;
      text-decoration: none;
      color: #fff;
      font-weight: 700;
      font-size: 13px;
      padding: 10px 14px;
      border-radius: 999px;
      background: linear-gradient(135deg, #ff6a2a, #ff3d3d);
    }
  </style>
</head>
<body>
  <div class="card">
    <p class="code">HTTP <%= status %></p>
    <h1>Tidak bisa menyelesaikan aksi</h1>
    <div hidden data-flash="error"><%= message %></div>
    <p><%= message %></p>
    <a href="<%= backUrl || '/admin' %>">Kembali</a>
  </div>
</body>
</html>
