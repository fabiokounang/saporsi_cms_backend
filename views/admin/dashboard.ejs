<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Dashboard • Samakan CMS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#f6f4f1;
      --card:#ffffff;
      --text:#111827;
      --muted:#6b7280;
      --line:#ece7e1;
      --accent:#ff6a2a;
      --accent2:#ff3d3d;
      --shadow: 0 18px 60px rgba(16,24,40,.10);
      --radius: 18px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Montserrat,system-ui,-apple-system,Segoe UI,Roboto,Arial;
      color:var(--text);
      background:
        radial-gradient(900px 500px at 15% 10%, rgba(255,106,42,.12), transparent 60%),
        radial-gradient(900px 500px at 85% 90%, rgba(255,61,61,.10), transparent 60%),
        linear-gradient(180deg, #fbfaf8, var(--bg));
      min-height:100vh;
    }

    .shell{
      display:grid;
      grid-template-columns: 260px 1fr;
      min-height:100vh;
    }
    @media (max-width: 980px){
      .shell{grid-template-columns: 1fr}
      aside{display:none}
    }

    /* ===== Sidebar ===== */
    aside{
      padding:18px;
      border-right:1px solid rgba(236,231,225,.9);
      background: rgba(255,255,255,.55);
      backdrop-filter: blur(8px);
    }
    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      padding:12px;
      border-radius: 16px;
      background: rgba(255,255,255,.75);
      border:1px solid rgba(255,255,255,.8);
      box-shadow: 0 10px 30px rgba(16,24,40,.06);
    }
    .logo{
      width:42px;height:42px;border-radius:14px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      box-shadow: 0 12px 26px rgba(255,106,42,.25);
    }
    .brand h1{margin:0;font-size:14px;letter-spacing:.3px}
    .brand p{margin:2px 0 0 0;font-size:12px;color:var(--muted)}

    nav{margin-top:16px}
    .navItem{
      display:flex;
      align-items:center;
      gap:10px;
      padding:11px 12px;
      border-radius: 14px;
      color:#374151;
      text-decoration:none;
      font-size:13px;
      font-weight:600;
      border:1px solid transparent;
      transition:.15s ease;
    }
    .navItem:hover{
      background: rgba(255,255,255,.8);
      border-color: rgba(236,231,225,.9);
    }
    .navItem.active{
      background: rgba(255,106,42,.12);
      border-color: rgba(255,106,42,.25);
      color:#111827;
    }
    .dot{
      width:8px;height:8px;border-radius:999px;
      background: rgba(17,24,39,.35);
    }
    .navItem.active .dot{
      background: linear-gradient(135deg, var(--accent), var(--accent2));
    }

    /* ===== Main ===== */
    main{padding:18px 18px 28px}

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      padding:14px 16px;
      border-radius: var(--radius);
      background: rgba(255,255,255,.8);
      border:1px solid rgba(236,231,225,.9);
      box-shadow: 0 12px 34px rgba(16,24,40,.06);
    }
    .topbar h2{margin:0;font-size:16px}
    .topbar .sub{color:var(--muted);font-size:12px;margin-top:2px}

    .userBox{
      display:flex;
      align-items:center;
      gap:10px;
      padding:8px 10px;
      border-radius:999px;
      background: rgba(255,255,255,.9);
      border:1px solid rgba(236,231,225,.9);
    }
    .avatar{
      width:34px;height:34px;border-radius:999px;
      background: rgba(17,24,39,.08);
      display:grid;place-items:center;
      font-weight:800;color:#374151;
    }
    .userMeta{line-height:1.2}
    .userMeta .name{font-size:12px;font-weight:700}
    .userMeta .role{font-size:11px;color:var(--muted)}

    .logout{
      margin-left:10px;
      padding:10px 14px;
      border-radius:999px;
      text-decoration:none;
      font-weight:700;
      font-size:12px;
      color:#fff;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      box-shadow: 0 14px 26px rgba(255,106,42,.20);
    }

    /* ===== Content ===== */
    .intro{
      margin-top:18px;
      max-width:720px;
    }
    .intro h3{
      margin:0 0 6px 0;
      font-size:18px;
    }
    .intro p{
      margin:0;
      color:var(--muted);
      line-height:1.7;
      font-size:13px;
    }

    .grid{
      margin-top:16px;
      display:grid;
      grid-template-columns: repeat(12, 1fr);
      gap:14px;
    }
    .card{
      grid-column: span 4;
      background: rgba(255,255,255,.9);
      border:1px solid rgba(236,231,225,.9);
      border-radius: var(--radius);
      padding:16px;
      box-shadow: 0 12px 30px rgba(16,24,40,.06);
      transition:.15s ease;
      text-decoration:none;
      color:inherit;
    }
    .card:hover{
      transform: translateY(-2px);
      box-shadow: 0 16px 40px rgba(16,24,40,.08);
      border-color: rgba(255,106,42,.35);
    }
    @media (max-width: 980px){
      .card{grid-column: span 12;}
    }

    .card h4{
      margin:0 0 6px 0;
      font-size:14px;
    }
    .card p{
      margin:0;
      font-size:12px;
      color:var(--muted);
      line-height:1.6;
    }
    .tag{
      display:inline-block;
      margin-top:10px;
      font-size:11px;
      font-weight:700;
      color:#b45309;
      background: rgba(255,106,42,.15);
      padding:6px 10px;
      border-radius:999px;
    }

    .kpis{
      margin-top:18px;
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:12px;
    }
    .kpi{
      background: rgba(255,255,255,.92);
      border:1px solid rgba(236,231,225,.9);
      border-radius: var(--radius);
      padding:16px;
      box-shadow: 0 12px 30px rgba(16,24,40,.06);
    }
    .kpi .label{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.3px;text-transform:uppercase}
    .kpi .value{margin:8px 0 4px;font-size:28px;font-weight:800;letter-spacing:-.5px}
    .kpi .hint{margin:0;font-size:12px;color:var(--muted)}
    .charts{
      margin-top:14px;
      display:grid;
      grid-template-columns: 280px 1fr;
      gap:12px;
    }
    .panel{
      background: rgba(255,255,255,.92);
      border:1px solid rgba(236,231,225,.9);
      border-radius: var(--radius);
      padding:16px;
      box-shadow: 0 12px 30px rgba(16,24,40,.06);
    }
    .panel h3{margin:0 0 4px;font-size:14px}
    .panel .sub{margin:0 0 14px;font-size:12px;color:var(--muted)}
    .donut-wrap{display:flex;align-items:center;gap:16px}
    .donut{position:relative;width:132px;height:132px;flex:0 0 132px}
    .donut svg{transform:rotate(-90deg)}
    .donut-center{
      position:absolute;inset:0;display:grid;place-items:center;text-align:center;
    }
    .donut-center strong{display:block;font-size:22px;line-height:1}
    .donut-center span{font-size:11px;color:var(--muted);font-weight:700}
    .legend{margin:0;padding:0;list-style:none;font-size:12px;color:#374151}
    .legend li{display:flex;align-items:center;gap:8px;margin:0 0 8px}
    .swatch{width:10px;height:10px;border-radius:99px}
    .bars{display:grid;gap:8px}
    .bar-row{display:grid;grid-template-columns:110px 1fr 36px;align-items:center;gap:10px}
    .bar-row span{font-size:12px;color:#374151;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .bar-row b{font-size:12px;text-align:right}
    .track{height:8px;border-radius:99px;background:#f3eee9;overflow:hidden}
    .fill{height:100%;border-radius:99px;background:linear-gradient(135deg,var(--accent),var(--accent2))}
    .alert-list{margin:0;padding:0;list-style:none}
    .alert-list li{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(236,231,225,.8);font-size:12px}
    .alert-list a{color:#b45309;font-weight:700;text-decoration:none}
    .section-title{margin:22px 0 0;font-size:14px}
    @media (max-width: 980px){
      .kpis,.charts{grid-template-columns:1fr}
      .kpi{grid-column:auto}
    }
  </style>
</head>
<body>
  <div class="shell">

    <%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>

    <!-- Main -->
    <main>
      <header class="topbar">
        <div>
          <h2>Dashboard</h2>
          <div class="sub">Content Management System</div>
        </div>

        <div style="display:flex;align-items:center;">
          <div class="userBox">
            <div class="avatar"><%= (user.name)[0].toUpperCase() %></div>
            <div class="userMeta">
              <div class="name"><%= user.name %></div>
              <div class="role">(<%= user.role %>)</div>
            </div>
          </div>
          <a class="logout" href="/auth/logout">Logout</a>
        </div>
      </header>

      <section class="intro">
        <h3>Kelola Tampilan Website Samakan</h3>
        <p>
          Ringkasan kelengkapan konten company profile. Bukan stok atau transaksi —
          angka di bawah diambil dari modul yang sudah terisi.
        </p>
      </section>

      <% if (typeof error !== 'undefined' && error) { %>
        <div hidden data-flash="error"><%= error %></div>
      <% } %>

      <% const s = typeof stats !== 'undefined' && stats ? stats : { totalItems:0, activeItems:0, media:0, completeness:0, readyCount:0, emptyCount:0, modules:[], needsWork:[] }; %>
      <% const maxBar = Math.max.apply(null, [1].concat((s.modules || []).map(function(m){ return m.total; }))); %>
      <% const circ = 339.292; %>
      <% const dash = Math.round((s.completeness / 100) * circ); %>

      <section class="kpis">
        <div class="kpi">
          <div class="label">Kelengkapan</div>
          <div class="value"><%= s.completeness %>%</div>
          <p class="hint"><%= s.readyCount %> dari <%= (s.readyCount + s.emptyCount) %> modul siap tayang</p>
        </div>
        <div class="kpi">
          <div class="label">Item konten</div>
          <div class="value"><%= s.totalItems %></div>
          <p class="hint"><%= s.activeItems %> aktif · <%= Math.max(0, s.totalItems - s.activeItems) %> nonaktif</p>
        </div>
        <div class="kpi">
          <div class="label">Media</div>
          <div class="value"><%= s.media %></div>
          <p class="hint">Gambar hero + gallery</p>
        </div>
        <div class="kpi">
          <div class="label">Perlu dilengkapi</div>
          <div class="value"><%= s.emptyCount %></div>
          <p class="hint"><%= s.emptyCount ? 'Ada modul yang masih kosong' : 'Semua modul sudah terisi' %></p>
        </div>
      </section>

      <section class="charts">
        <div class="panel">
          <h3>Status modul</h3>
          <p class="sub">Siap tayang vs masih perlu diisi.</p>
          <div class="donut-wrap">
            <div class="donut">
              <svg width="132" height="132" viewBox="0 0 132 132" aria-hidden="true">
                <circle cx="66" cy="66" r="54" fill="none" stroke="#f3eee9" stroke-width="14"></circle>
                <circle cx="66" cy="66" r="54" fill="none" stroke="url(#dashGrad)" stroke-width="14" stroke-linecap="round"
                  stroke-dasharray="<%= dash %> <%= circ - dash %>"></circle>
                <defs>
                  <linearGradient id="dashGrad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#ff6a2a"></stop>
                    <stop offset="100%" stop-color="#ff3d3d"></stop>
                  </linearGradient>
                </defs>
              </svg>
              <div class="donut-center">
                <div>
                  <strong><%= s.completeness %>%</strong>
                  <span>siap</span>
                </div>
              </div>
            </div>
            <ul class="legend">
              <li><span class="swatch" style="background:linear-gradient(135deg,#ff6a2a,#ff3d3d)"></span> <%= s.readyCount %> modul siap</li>
              <li><span class="swatch" style="background:#e5e0da"></span> <%= s.emptyCount %> perlu dilengkapi</li>
            </ul>
          </div>
          <% if (s.needsWork && s.needsWork.length) { %>
            <ul class="alert-list">
              <% s.needsWork.forEach(function(item){ %>
                <li>
                  <span><%= item.label %></span>
                  <a href="<%= item.href %>">Lengkapi</a>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <div class="panel">
          <h3>Jumlah item per modul</h3>
          <p class="sub">Kartu, foto, menu, lokasi, dan tautan yang tersimpan.</p>
          <div class="bars">
            <% (s.modules || []).forEach(function(m){ %>
              <div class="bar-row">
                <span title="<%= m.label %>"><%= m.label %></span>
                <div class="track"><div class="fill" style="width:<%= Math.round((m.total / maxBar) * 100) %>%"></div></div>
                <b><%= m.total %></b>
              </div>
            <% }) %>
          </div>
        </div>
      </section>

      <% if (false) { %>
      <h3 class="section-title">Pintasan modul</h3>
      <section class="grid">
        <a href="/admin/navbar" class="card">
          <h4>Navbar</h4>
          <p>Atur menu navigasi, urutan, dan label bahasa.</p>
          <span class="tag">Navigation</span>
        </a>

        <a href="/admin/home" class="card">
          <h4>Home</h4>
          <p>Konten landing page, hero section, dan highlight utama.</p>
          <span class="tag">Landing Page</span>
        </a>

        <a href="/admin/about" class="card">
          <h4>About Us</h4>
          <p>Profil perusahaan, visi, dan cerita Samakan.</p>
          <span class="tag">Company</span>
        </a>

        <a href="/admin/services" class="card">
          <h4>Services</h4>
          <p>Daftar layanan dan solusi yang ditawarkan.</p>
          <span class="tag">Services</span>
        </a>

        <a href="/admin/how-it-works" class="card">
          <h4>How It Works</h4>
          <p>Alur Kerja Samakan.</p>
          <span class="tag">HIW</span>
        </a>

        <a href="/admin/gallery" class="card">
          <h4>Gallery</h4>
          <p>Kelola foto dan dokumentasi kegiatan.</p>
          <span class="tag">Media</span>
        </a>

        <a href="/admin/locations" class="card">
          <h4>Location</h4>
          <p>Kelola lokasi.</p>
          <span class="tag">Lokasi</span>
        </a>

        <a href="/admin/partners" class="card">
          <h4>Partners</h4>
          <p>Kelola mitra.</p>
          <span class="tag">Mitra</span>
        </a>

        <a href="/admin/early-program" class="card">
          <h4>Early Program</h4>
          <p>Kelola early program.</p>
          <span class="tag">Early Program</span>
        </a>

        <a href="/admin/contact" class="card">
          <h4>Contact</h4>
          <p>Kelola contact form.</p>
          <span class="tag">Contact</span>
        </a>

        <a href="/admin/cta" class="card">
          <h4>CTA (Click To Action)</h4>
          <p>Kelola CTA.</p>
          <span class="tag">CTA</span>
        </a>

        <a href="/admin/footer" class="card">
          <h4>Footer</h4>
          <p>Kelola Footer.</p>
          <span class="tag">Footer</span>
        </a>
      </section>
      <% } %>
    </main>

  </div>
</body>
</html>
